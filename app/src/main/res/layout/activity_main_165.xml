<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/emerald_bg_165">

    <!-- Header / Toolbar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/emerald_dark_165"
        android:padding="20dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvGreeting165"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Halo, User!"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnLogout165"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Logout"
                style="?attr/materialButtonOutlinedStyle"
                android:textColor="@color/white"
                app:strokeColor="@color/white"
                android:minHeight="36dp"
                android:paddingHorizontal="8dp"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Summary Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/emerald_primary_165">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total Pengeluaran"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:alpha="0.9"/>

                <TextView
                    android:id="@+id/tvTotalExpense165"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rp 0"
                    android:textColor="@color/white"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="12dp">

                    <TextView
                        android:id="@+id/tvTransactionCount165"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jumlah Transaksi: 0"
                        android:textColor="@color/white"
                        android:textSize="13sp"/>
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Content Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Search Bar -->
        <EditText
            android:id="@+id/etSearch165"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Cari kategori atau keterangan..."
            android:inputType="text"
            android:autofillHints="search"
            android:background="@android:drawable/editbox_background_normal"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <!-- Category Filter Spinner & Add Button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <Spinner
                android:id="@+id/spinnerFilterCategory165"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@android:drawable/btn_dropdown"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnAddTransaction165"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+ Tambah"
                android:backgroundTint="@color/emerald_primary_165"
                android:textColor="@color/white"
                android:minHeight="40dp"
                android:textSize="13sp"/>
        </LinearLayout>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvTransactions165"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Empty State -->
        <TextView
            android:id="@+id/tvEmptyState165"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Tidak ada transaksi yang ditemukan."
            android:textSize="16sp"
            android:textColor="@color/gray_light_165"
            android:visibility="gone"/>

    </LinearLayout>

</LinearLayout>
