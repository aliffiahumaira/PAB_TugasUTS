<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/card_bg_165">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvCategory165"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kategori"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/emerald_primary_165"/>

            <TextView
                android:id="@+id/tvDescription165"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keterangan transaksi"
                android:textSize="16sp"
                android:textColor="@color/gray_dark_165"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/tvDate165"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09-11-2026"
                android:textSize="12sp"
                android:textColor="@color/gray_light_165"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvAmount165"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rp 50.000"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/emerald_dark_165"
            android:layout_marginEnd="8dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnEdit165"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="✏"
                android:textSize="12sp"
                android:backgroundTint="@color/emerald_light_165"
                android:textColor="@color/white"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginEnd="4dp"/>

            <Button
                android:id="@+id/btnDelete165"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="🗑"
                android:textSize="12sp"
                android:backgroundTint="@android:color/holo_red_dark"
                android:textColor="@color/white"
                android:padding="0dp"
                android:minWidth="0dp"
                android:minHeight="0dp"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
